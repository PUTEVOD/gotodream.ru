+/* На тач-экране состояния :hover нет.
+
+   Раньше здесь стояло `@media (hover: none) .tooltip { opacity: 1 }` —
+   подсказки висели над ползунками постоянно. Две беды сразу: в шторке
+   фильтров крайние подсказки «00:00» и «24:00» вылезали за левый и правый
+   край панели (ползунок стоит в самом начале трека, подсказка центрируется
+   по нему и половиной ширины уходит наружу), и, главное, они дублировали
+   то, что и так написано в заголовке фильтра — «Время вылета 00:00 - 24:00».
+
+   Правило снято. Подсказка остаётся там, где она нужна: во время
+   перетаскивания (.is-active) и при фокусе с клавиатуры — то есть ровно
+   тогда, когда палец закрывает собой значение в заголовке. */
 @media (hover: none) {
-    .tooltip {
-        opacity: 1;
-    }
-
     .swap-direction:hover {
         color: inherit;
     }
 }
 
+/* Подсказка не выходит за края колонки фильтров.
+
+   Вместо центрирования по ползунку каждая подсказка прижимается к нему с
+   той стороны, с которой ползунок может дойти до края трека: у левого —
+   левым краем, у правого — правым. В середине диапазона смещение на
+   половину ширины подсказки незаметно, а на краях она гарантированно
+   остаётся внутри. */
+.slider-handle.lower .tooltip {
+    left: 0;
+    right: auto;
+    transform: none;
+}
+
+.slider-handle.upper .tooltip {
+    left: auto;
+    right: 0;
+    transform: none;
+}
+
 /* Фокус с клавиатуры виден на кастомных галочках и радиокнопках:
    нативный input скрыт, и без этого правила обводке не на чем появиться.
 
