# Настройки сборки для продакшена. Файл читает react-scripts, он попадает в
# репозиторий (в отличие от .env.production.local, который в .gitignore).

# Карты исходников не кладутся рядом со сборкой.
#
# По умолчанию react-scripts генерирует .js.map на каждый бандл и выкладывает
# их в build/ — это полный исходный код проекта, включая комментарии, доступный
# любому, кто откроет вкладку Sources. Плюс лишние мегабайты в раздаче.
# В режиме разработки (npm start) карты работают как раньше: этот файл на него
# не влияет.
GENERATE_SOURCEMAP=false

# Рантайм-чанк не встраивается в index.html.
#
# По умолчанию react-scripts вставляет его инлайном ради экономии одного
# запроса. Инлайновый <script> без nonce или hash запрещён любой строгой
# политикой Content-Security-Policy, а она рано или поздно понадобится сайту,
# который принимает данные пользователей.
#
# Оговорка: один инлайновый скрипт на странице остаётся — тот, что выставляет
# тему до первой отрисовки (см. public/index.html). Вынести его в файл нельзя,
# иначе вернётся вспышка чужой темы. Но его содержимое стабильно, и для CSP
# достаточно одного постоянного hash в политике — в отличие от рантайм-чанка,
# который меняется на каждой сборке.
INLINE_RUNTIME_CHUNK=false
