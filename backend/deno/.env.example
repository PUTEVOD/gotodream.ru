# Образец файла .env для локальной разработки.
#
#   cp .env.example .env
#
# Файл .env содержит пароль и НЕ должен попадать в репозиторий:
# он закрыт в backend/deno/.gitignore. На сервере те же значения задаются
# переменными окружения (systemd, docker, панель хостинга), а не файлом.

# ---------------------------------------------------------------- сервер ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------- источник ---
# mock — встроенный генератор выдачи, сеть не нужна.
# s7   — реальный NDC-шлюз S7 (agent-api/gaia).
FLIGHT_PROVIDER=mock

# Кэш ответов поставщика. Смена фильтров на странице не должна дёргать шлюз.
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_MS=300000
SEARCH_CACHE_MAX_ENTRIES=200

# Хранилище выдачи по searchId: из него подтверждение цены берёт выбранное
# предложение. Время жизни — это то, сколько человек выбирает рейс из списка,
# поэтому оно заметно больше, чем у кэша.
SEARCH_RESULTS_TTL_MS=1200000
SEARCH_RESULTS_MAX_ENTRIES=500

# ------------------------------------------------------------- шлюз S7 ----
S7_ENDPOINT=https://qa-gaia.s7.ru/agent-api/gaia

# Basic-auth тестового стенда. Значения выданы S7 вместе с доступом.
S7_LOGIN=go_to_dream
S7_PASSWORD=

# Реквизиты агента внутри конверта (Party/Sender/AgentUserSender).
S7_PSEUDO_CITY=S7AGN8224
S7_AGENT_USER_ID=go_to_dream
S7_SENDER_NAME=S7-AIDL
S7_USER_ROLE=AS
S7_POS_TYPE=1
S7_REQUESTOR_TYPE=U

# Операция поиска: searchFlightsJourney отдаёт готовые варианты перелёта.
S7_OPERATION=searchFlightsJourney
# Операция подтверждения цены: ItinReshopRQ -> ItinReshopRS.
S7_REPRICE_OPERATION=reprice
S7_SOAP_ACTION_BASE=http://api.s7.ru

# Заголовок X-API-Version. Пусто — не отправлять. В примерах обмена со стендом
# встречается значение 0.52. Первое, что стоит включить, если шлюз отказывает
# без внятной причины.
S7_API_VERSION=

S7_TIMEOUT_MS=25000
S7_RETRIES=1

# Передавать ли класс обслуживания в запросе. Выключено: соответствие
# «эконом/комфорт/бизнес» кодам PADIS на стороне S7 не подтверждено.
S7_SEND_CABIN_PREFERENCE=false

# ------------------------------------------------------------- отладка ----
# Каталог для дампов сырого XML. Пусто — не писать.
S7_DUMP_DIR=

# Пути к сохранённым ответам. Если заданы, сеть не используется вообще —
# удобно разрабатывать фронт и парсер без доступа к стенду:
#   S7_FIXTURE=search/providers/s7/fixtures/airshopping-rs-ow-adt.xml
#   S7_REPRICE_FIXTURE=search/providers/s7/fixtures/itinreshop-rs-rt-adt-chd-inf.xml
S7_FIXTURE=
S7_REPRICE_FIXTURE=
